#!/usr/bin/env bash
# Every check this repo has, behind one command and one verdict.
#
#   ./check             the quick tier — under a minute on a warm tree:
#                         tracked  every source file is in the git tree
#                         fmt      cargo fmt --check
#                         build    cargo build --workspace
#                         test     cargo test, bar the two slow crates
#                         pins     bims --self-check: the design hash and
#                                  the world checksum against their
#                                  written-down constants
#                         clippy   cargo clippy on the app, warnings as errors
#                         smoke    four windows open, draw sixty frames and
#                                  exit, leaving a screenshot in target/check/
#   ./check full        the same, deepened — every test, every window — and
#                       then probes (the room's native probes) and flake
#                       (nix flake check)
#   ./check <step>...   only those steps, in that order
#   ./check --list      the steps and what each is for
#
# Why the quick tier leaves so much out: a check that takes ten minutes is a
# check that gets run once a day. The measurement (warm tree, this machine)
# was `test` 272 s of a 330 s run, and 230 s of that is `world` and `ship` —
# 275 world tests with no slow outliers to skip, three to ten seconds each,
# because every one of them steps the clock. So the quick tier runs the
# other nine crates and `bims --self-check`, which pins the two numbers a
# rules change is most likely to move, and leaves the two slow crates'
# suites, the exhaustive sweeps (`BIMS_SWEEP=1`) and the windows that are
# another window with a dial moved to `./check full`.
#
# So: `./check` before every commit; `./check full`, or at least
# `./check test` with DEEP=1, before saying a rules change is done.
#
# Two things about how it runs:
#
#   * The toolchain comes from shell.nix: if cargo is not on PATH, or ALSA
#     is not where pkg-config can see it, the script re-runs itself inside
#     `nix-shell shell.nix`. The smoke step runs each window through
#     ./hidden — a headless compositor, so nothing opens on the desktop.
#   * The probes are compiled into target/probes/, never into scratchpad/:
#     a stale binary printing a confident pass is how three rounds of bugs
#     got through, so a compile failure here is a step failure.
set -uo pipefail
cd "$(dirname "$0")"

if ! command -v cargo >/dev/null || ! pkg-config --exists alsa 2>/dev/null; then
  exec nix-shell shell.nix --run "./check $*"
fi

QUICK=(tracked fmt build test pins clippy smoke)
FULL=("${QUICK[@]}" probes flake)

# 1 in the full tier: the test step runs every crate and asks for its
# sweeps, and the smoke step opens every window rather than four.
# `DEEP=1 ./check test` is one step of the full tier without the rest.
DEEP=${DEEP:-0}

# The two slow crates, left out of the quick tier's tests. Between them
# they are 230 of the 250 seconds the workspace's tests take.
SLOW_CRATES=(world ship)

# How many windows the smoke step opens at once. Each is a compositor and a
# Bevy of its own and spends most of its seven seconds starting up, so the
# quick tier's four go in one batch. One, to read a run's output as it happens.
SMOKE_AT_ONCE=${SMOKE_AT_ONCE:-5}

# How long a single probe may run before the step gives up on it — so that a
# probe which stops finishing *fails* rather than hanging the check.
PROBE_SECONDS=${PROBE_SECONDS:-120}

LOGS=target/check
mkdir -p "$LOGS" target/probes

# ---------------------------------------------------------------------------
# the steps

describe() {
  cat <<'EOF'
tracked   every file under crates/ and scratchpad/ is known to git —
          `nix run .` and `nix flake check` build from the git tree, and a
          file that is only on disk is a build that cannot find its module
fmt       cargo fmt --check
build     cargo build --workspace: the app, and every crate it stands on
test      cargo test: the designer's and lobby's geometry, the room, and the
          app's tables — bar `world` and `ship`, whose suites are 230 of the
          250 seconds the workspace's tests take and are the full tier's,
          where `BIMS_SWEEP=1` also turns the station walk back into every
          plan on every kind at every seed rather than a slice
pins      bims --self-check: `design_hash` and `world_checksum` against the
          constants in shipdesign::fixture and world::fixture, which is what
          the quick tier's missing rules tests would most likely have caught
clippy    cargo clippy on the app crate, with warnings as errors
smoke     `bims game`, `simulation`, `design` and `droids` (the fight: a
          wave of machines on the arena's deck) each run sixty frames in a
          hidden window and exit, all at once, leaving a screenshot in
          target/check/ — a black picture is a bug no test sees. The full
          tier adds the rest: `test`, `test_planet`, the five
          `combat_droids_<class>` fights, `tier2_test`, `tier3_test`,
          `droid_kinds` (every drawing of a machine in a row),
          `droids_planet`, `stationbuilder`, and `restarted` — the Esc
          sheet's Restart pressed on `droids` (feature 79)
probes    every scratchpad/*.rs probe compiled fresh into target/probes/ and
          run; a compile failure is a failure, and so is a probe that runs
          past `PROBE_SECONDS` (120) rather than hanging the check
flake     nix flake check — the build as `nix run .` sees it, from the git tree
EOF
}

step_tracked() {
  local stray
  stray=$(git ls-files --others --exclude-standard crates scratchpad)
  if [ -n "$stray" ]; then
    echo "not in the git tree (nix builds from it — \`git add -N\` each):"
    echo "$stray" | sed 's/^/  /'
    return 1
  fi
  echo "every source file is tracked"
}

step_fmt() {
  cargo fmt --check -- --color never
}

step_build() {
  cargo build --workspace
}

step_test() {
  # `world` and `ship` are the full tier's, and so are the sweeps:
  # `BIMS_SWEEP=1` turns the station navigation walk back into every plan on
  # every kind at every seed, which on its own is longer than the rest of the
  # workspace's tests.
  local args=() c
  if [ "$DEEP" = 1 ]; then
    export BIMS_SWEEP=1
  else
    for c in "${SLOW_CRATES[@]}"; do args+=(--exclude "$c"); done
  fi
  if cargo test --workspace ${args[@]+"${args[@]}"} >"$LOGS/test.log" 2>&1; then
    test_counts
  else
    command grep -E "FAILED|panicked at|^error" "$LOGS/test.log" | command grep -v "^test result" | head -30 | sed 's/^/  /'
    test_counts
    return 1
  fi
}

# The tail of every suite's `test result:` line, added up, so a quick run
# says out loud that it is not the whole workspace.
test_counts() {
  command grep -E "^test result" "$LOGS/test.log" |
    awk '{p+=$4; f+=$6; i+=$8; s+=$12} END {printf "  %d passed, %d failed, %d ignored, %d skipped", p, f, i, s}'
  if [ "$DEEP" = 1 ]; then echo; else echo " (${SLOW_CRATES[*]} are ./check full's)"; fi
}

step_pins() {
  # Two numbers that have to come out identical everywhere, pinned against
  # written-down constants: a rules change that moves one without moving the
  # constant is what the quick tier's missing world/ship suites would catch.
  target/debug/bims --self-check
}

step_clippy() {
  # The app only. The rules crates predate clippy here and carry a few
  # hundred style lints that are not bugs; the app was written under it.
  cargo clippy -p app --no-deps --all-targets -- -D warnings
}

# One window: everything about `$1` — what it is staged with, how many
# frames it wants, what its log has to say — and its verdict line, which it
# prints rather than returning, since the runs go several at a time.
# Success is the marker file `smoke-<what>.ok`.
smoke_one() {
  local what=$1 shot frames wants
  shot=""
  case "$what" in simulation | design | test_planet | droids | droid_kinds) shot="$LOGS/smoke-$what.png" ;; esac
  rm -f "$shot"
  local staged="" run="$what"
  frames=60
  wants=""
  # `restarted` is the Esc sheet's Restart pressed (feature 79). The clicks
  # are where the buttons are in a 1400x900 window at 100%; the run only
  # counts if the world actually went back, which is what `wants` looks for.
  [ "$what" = restarted ] && {
    staged="BIMS_KEYS=30:Escape BIMS_POINTER='60:move:673,496;62:click:673,496;90:move:562,489;92:click:562,489' "
    run=droids
    frames=150
    wants="^restart: "
  }
  # `droid_kinds` is `droids` with every state a machine can be drawn in laid
  # out on the arena's deck — a row a kind, a column a state (feature 83).
  [ "$what" = droid_kinds ] && { staged="BIMS_DROIDS=1 "; run=droids; }
  # The builder reads and writes stations/; a smoke run gets a scratch
  # directory so it cannot touch a sketch somebody is drawing. And the saves:
  # one each, since the runs go several at a time.
  [ "$what" = stationbuilder ] && staged="BIMS_STATIONS_DIR=$LOGS/stations "
  staged="${staged}BIMS_SAVES_DIR=$LOGS/saves/$what "
  local cmd="${staged}BIMS_SMOKE_FRAMES=$frames ${shot:+BIMS_SCREENSHOT=$shot} ./hidden target/debug/bims $run"
  if timeout 180 bash -c "$cmd" >"$LOGS/smoke-$what.log" 2>&1 &&
    { [ -z "$shot" ] || [ -s "$shot" ]; } &&
    { [ -z "$wants" ] || command grep -qE "$wants" "$LOGS/smoke-$what.log"; }; then
    echo "  ok   $what${shot:+  → $shot}"
    : >"$LOGS/smoke-$what.ok"
  else
    echo "  FAIL $what"
    command grep -iE "panic|error" "$LOGS/smoke-$what.log" | head -10 | sed 's/^/       /'
  fi
}

step_smoke() {
  local fail=0 what
  # Every run goes through ./hidden: a headless compositor of its own, so the
  # windows open on nobody's desktop. Four windows in the quick tier — the
  # menu, the world, the yard and a fight — and every other window
  # in the full one, since each of those is one of these with a dial moved.
  # The fight is `droids`: every enemy is a machine since feature 102.
  local runs=(game simulation design droids)
  [ "$DEEP" = 1 ] && runs+=(test test_planet combat_droids_engineer combat_droids_soldier combat_droids_medic combat_droids_tank combat_droids_commander tier2_test tier3_test droid_kinds droids_planet restarted stationbuilder)
  # `SMOKE_AT_ONCE` at a time; nothing is shared — a log, a screenshot and a
  # saves directory each. The lines are held and printed in the list's order
  # afterwards, so the step reads as it did when it was one run after another.
  for what in "${runs[@]}"; do
    rm -f "$LOGS/smoke-$what.ok"
    smoke_one "$what" >"$LOGS/smoke-$what.out" 2>&1 &
    while [ "$(jobs -rp | wc -l)" -ge "$SMOKE_AT_ONCE" ]; do wait -n; done
  done
  wait
  for what in "${runs[@]}"; do
    cat "$LOGS/smoke-$what.out"
    [ -f "$LOGS/smoke-$what.ok" ] || fail=1
  done
  return $fail
}

step_probes() {
  local fail=0 src name bin
  for src in scratchpad/*.rs; do
    name=$(basename "$src" .rs)
    # modules.rs is the shared module list; layout.rs is a picture, not a test.
    case "$name" in modules | layout) continue ;; esac
    bin="target/probes/$name"
    rm -f "$bin"
    if ! rustc --edition 2024 -O "$src" -o "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  FAIL $name did not compile"
      command grep -E "^error" -A 6 "$LOGS/probe-$name.log" | head -30 | sed 's/^/       /'
      fail=1
      continue
    fi
    # Under a clock of its own, because a probe steps the room until
    # something happens and a change that stops it happening is a probe that
    # runs for ever — and a check that hangs is a check nobody runs.
    if timeout "$PROBE_SECONDS" "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  ok   $name"
    elif [ $? = 124 ]; then
      echo "  FAIL $name ran past ${PROBE_SECONDS}s and was stopped"
      fail=1
    else
      echo "  FAIL $name"
      command grep -E "FAIL|panicked" "$LOGS/probe-$name.log" | head -20 | sed 's/^/       /'
      fail=1
    fi
  done
  return $fail
}

step_flake() {
  nix flake check
}

# ---------------------------------------------------------------------------
# the runner

usage() {
  sed -n '4,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

steps=()
case "${1:-}" in
  "") steps=("${QUICK[@]}") ;;
  full)
    steps=("${FULL[@]}")
    DEEP=1
    ;;
  --list | -l) describe; exit 0 ;;
  -h | --help) usage ;;
  *)
    for s in "$@"; do
      if ! declare -F "step_$s" >/dev/null; then
        echo "./check: no such step: $s" >&2
        echo "steps: ${FULL[*]}" >&2
        exit 2
      fi
      steps+=("$s")
    done
    ;;
esac

failed=()
summary=()
began=$SECONDS
for s in "${steps[@]}"; do
  echo "== $s"
  start=$SECONDS
  # Steps that print their own per-item lines write to the terminal; the rest
  # are quiet on success and shown in full on failure.
  case "$s" in
    tracked | test | smoke | probes)
      if "step_$s"; then ok=1; else ok=0; fi
      ;;
    *)
      if "step_$s" >"$LOGS/$s.log" 2>&1; then
        ok=1
      else
        ok=0
        tail -40 "$LOGS/$s.log" | sed 's/^/  /'
      fi
      ;;
  esac
  took=$((SECONDS - start))
  if [ $ok = 1 ]; then
    summary+=("$(printf '  ok    %-8s %4ss' "$s" "$took")")
  else
    summary+=("$(printf '  FAIL  %-8s %4ss   target/check/%s*.log' "$s" "$took" "$s")")
    failed+=("$s")
  fi
done

echo
echo "== summary ($((SECONDS - began))s)"
printf '%s\n' "${summary[@]}"
if [ ${#failed[@]} -gt 0 ]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "all green"
