// How loud each sound is, tuned while the game runs.
//
// The game reads this file again whenever it is saved (BIMS_AUDIO names
// another). Each number multiplies the level the game plays that sound at:
// 1 is as built, 0 is never heard, 0.5 half as loud, 2 twice. A sound left
// out is 1, a misspelt name or a file that does not parse keeps the last
// good numbers (the reason is printed on the terminal).
//
// These sit under the Esc sheet's audio page: master, effects (every
// one-shot below) and ambience (the five loops) still turn the lot.
//
// A sound is named as its clip in Sounds/game/ is, and a clip heard
// in several places is turned in all of them — but a weapon that borrows
// another's report has its own line at the end.
(
    // The crew's and the machines' guns.
    laser_1: 1.0,           // the laser pistol, nine takes at random
    laser_2: 1.0,
    laser_3: 1.0,
    laser_4: 1.0,
    laser_5: 1.0,           // laser_1 a semitone up
    laser_6: 1.0,           // laser_2 a semitone up
    laser_7: 1.0,           // laser_3 a semitone and a half up
    laser_8: 1.0,           // laser_4 a semitone and a half up
    laser_9: 1.0,           // laser_1 two semitones up
    shotgun: 1.0,
    rifle: 1.0,             // the auto rifle
    sniper: 1.0,            // the sniper rifle
    reload_1: 0.8,          // a magazine reloaded, every gun but the shotgun, one take
    reload_2: 0.8,          // and the other
    shotgun_reload: 1.0,    // the shotgun's shells put in

    // Hits.
    laser_hit: 0.5,         // a bolt landing on a body
    laser_wall: 0.5,        // a bolt off a wall, or a Guardian's shield
    ouch: 0.4,              // one of the crew hit
    schword: 0.9,           // a blade's cut
    punch: 0.8,             // a blow that is not a cut

    // Doors.
    door_open: 1.0,
    door_close: 1.0,
    door_force: 1.0,        // a body heaving at a locked door, and it giving

    // A player's hand.
    draw: 1.0,              // a weapon out of its holster
    holster: 1.0,           // and back in; also a Brace let go

    // The trader and the pay.
    bought: 1.0,            // anything bought, by anyone in the crew
    sold: 1.0,              // anything sold to the trader, by anyone in the crew
    reward: 1.0,            // the chime of an enemy down and its pay

    // The crew.
    downed: 1.0,            // a player downed (not a bot)
    revived: 1.0,           // a body brought round, a player up or reviving
    level_up: 1.0,          // the player's own level gained

    // The classes' abilities.
    grenade_throw: 1.0,
    grenade_burst: 1.0,
    brace: 1.0,
    rampage: 1.0,
    emp_throw: 1.0,
    emp_burst: 1.0,
    healing_sentry: 1.0,
    sandbags: 1.0,
    sentry: 1.0,
    nanite_burst: 1.0,
    beam_on: 1.0,
    beam_off: 1.0,
    cloak: 1.0,
    taunt: 1.0,
    bulwark_on: 1.0,
    bulwark_off: 1.0,
    juggernaut: 1.0,
    battle_cry: 1.0,
    rally: 1.0,
    reinforcements: 1.0,

    // The tier-two machines' warnings.
    bomb_armed: 0.7,        // a bomb rolling and spinning up
    rail_charge: 0.8,       // a Lancer charging its rail
    marked: 0.5,            // a Conductor's mark on somebody
    blink: 0.5,          // a Conductor blinking away
    smoke_bang: 0.7,     // a Smoke Launcher's canister going off
    smoke_run: 0.7,     // its cloud hissing while it hangs
    smoke_out: 0.6,     // the cloud going out

    // The loops.
    ship: 1.0,              // the ship's hum
    station: 1.0,           // a station's, docked
    temperate: 1.0,         // a planet's air, by biome
    desert: 1.0,
    arctic: 1.0,

    // Weapons with no clip of their own, turned apart from the one they
    // borrow.
    minigun: 1.0,           // the rifle's report, quiet
    rail_lance: 1.0,        // the sniper's, loud
    unmaker: 1.0,           // the sniper's
)
