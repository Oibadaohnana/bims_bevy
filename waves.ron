// How many machines come, tuned while the game runs.
//
// The game reads this file again whenever it is saved (BIMS_WAVES names
// another). The next wave laid and the next station's wave count take the
// new numbers; a wave already standing keeps its size. A field left out is
// the built-in value, and a file that does not parse keeps the last good
// numbers (the reason is printed on the terminal).
//
//   a wave            = base + per_player * players + per_step * steps
//   steps             = whole step_hours of the world clock (a trip moves it)
//   waves at a station = waves_base + steps / steps_per_wave   (0: never more)
//   the run's first mission: every wave first_mission_ease fewer, never under 1
//
// The values below are the built-in ones.
(
    base: 2,
    per_player: 1,
    per_step: 1,
    step_hours: 504, // 21 days
    waves_base: 2,
    steps_per_wave: 2,
    first_mission_ease: 1,
)
